{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "constriant-solver-construction",
    "type": "object",
    "properties": {
        "output": {
            "type": "string",
            "default": ""
        },
        "dump": {
            "type": "string",
            "default": ""
        },
        "imports": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "default": []
        },
        "definitions": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "definition": {
                        "type": "string"
                    },
                    "delayed": {
                        "type": "boolean",
                        "default": false
                    }
                },
                "required": [
                    "name",
                    "definition"
                ]
            }
        },
        "constraints": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "variables": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "assertions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "restrictions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "variables",
                    "assertions",
                    "restrictions"
                ]
            }
        },
        "minX": {
            "type": "number",
            "default": 0
        },
        "minY": {
            "type": "number",
            "default": 0
        },
        "width": {
            "type": "number",
            "default": 100
        },
        "height": {
            "type": "number",
            "default": 100
        },
        "curves": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "enum": [
                            "A",
                            "a",
                            "C",
                            "c",
                            "CS",
                            "CSS",
                            "dot",
                            "H",
                            "h",
                            "L",
                            "l",
                            "M",
                            "m",
                            "Q",
                            "q",
                            "S",
                            "s",
                            "T",
                            "t",
                            "V",
                            "v",
                            "Z",
                            "z"
                        ]
                    },
                    "params": {
                        "type": "string"
                    },
                    "debug": {
                        "type": "boolean",
                        "default": false
                    }
                },
                "required": [
                    "type",
                    "params"
                ]
            }
        },
        "transform": {
            "type": "string",
            "default": "1 0 0 1 0 0"
        },
        "export": {
            "type": "boolean",
            "default": false
        }
    },
    "required": [
        "definitions",
        "constraints",
        "curves"
    ]
}